# Copy to .env.local and fill in. Never commit .env.local.

# Used by Convex CLI (`npm run convex:dev`, deploy, codegen)
CONVEX_DEPLOYMENT=dev:your-deployment-slug

# Used by watcher.js (ConvexHttpClient)
CONVEX_URL=https://your-deployment-slug.convex.cloud

# Optional site URL (e.g. HTTP actions)
# CONVEX_SITE_URL=https://your-deployment-slug.convex.site

# Optional: full deploy key for `npm run convex:deploy` without interactive login
# CONVEX_DEPLOY_KEY=dev:your-deployment-slug|your-secret-from-dashboard

# MySQL (watcher.js) — .env.local is not in git; copy this file on each machine.
# MYSQL_HOST=127.0.0.1
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=
# If you see AUTH_SWITCH_PLUGIN_ERROR / unknown plugin, keep default (allow public key) or set on server:
# ALTER USER 'user'@'%' IDENTIFIED WITH mysql_native_password BY 'same-password';
# MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=0   # set to 0 only if you must disable it
# MYSQL_SSL=1                            # optional TLS to MySQL
# MYSQL_SSL_REJECT_UNAUTHORIZED=0        # with MYSQL_SSL=1, allow self-signed
